      ],
      "updated": 1791542667433,
      "created": 1791527997999,
      "link": null,
      "locked": false,
      "text": "Q_π(S_t,A_t) = E[G_t|S_t,A_t]\n                  = E[R_{t+1}+γG_{t+1}|S_t,A_t]\n                  = R_{t+1}+γE[G_{t+1}|S_t,A_t]\n                  = R_{t+1}+γE_{S_{t+1}~π(S_t,A_t)}[ E[G_{t+1}|S_t,A_t,S_{t+1}] ]\n                  = R_{t+1}+γE_{S_{t+1}~π(S_t,A_t)}[ E[G_{t+1}|S_{t+1}] ]\n                  = R_{t+1}+γE_{S_{t+1}~π(S_t,A_t)}[ V_π(S_{t+1}) ]\n                    when environment is deterministic\n                  = R_{t+1}+γV_π(S_{t+1})",
      "fontSize": 12.253342062928322,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q_π(S_t,A_t) = E[G_t|S_t,A_t]\n                  = E[R_{t+1}+γG_{t+1}|S_t,A_t]\n                  = R_{t+1}+γE[G_{t+1}|S_t,A_t]\n                  = R_{t+1}+γE_{S_{t+1}~π(S_t,A_t)}[ E[G_{t+1}|S_t,A_t,S_{t+1}] ]\n                  = R_{t+1}+γE_{S_{t+1}~π(S_t,A_t)}[ E[G_{t+1}|S_{t+1}] ]\n                  = R_{t+1}+γE_{S_{t+1}~π(S_t,A_t)}[ V_π(S_{t+1}) ]\n                    when environment is deterministic\n                  = R_{t+1}+γV_π(S_{t+1})",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
