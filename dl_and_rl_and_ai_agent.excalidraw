    {
      "id": "Et_zo6gW0XrhCjU3jA_pZ",
      "type": "text",
      "x": 16853.946377603133,
      "y": -3126.7539543073267,
      "width": 1213.9271102694447,
      "height": 64.32710218806824,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
