    {
      "id": "8rdKdjYPL-7TSINlTQuEJ",
      "type": "text",
      "x": -469.63648881004576,
      "y": 2646.3783352939145,
      "width": 780.7355780564606,
      "height": 93.04616349457432,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bfg",
      "roundness": null,
      "seed": 1840389974,
      "version": 1374,
      "versionNonce": 959066783,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794294194710,
      "created": 1791540952607,
      "link": null,
      "locked": false,
      "text": "online一般为: loop(1->2->3->4->5->6->...) or loop(1->2->3->4->6->... and then 5)\n...表示重复左边的过程，也是loop的意思，所以可...省略,loop表示一个episode\noffline一般为:loop(1->2->3->4->6->...) and then 5 (use the data generated in the before loop) 注意和loop(1-\n>2->3->4->6->... and then 5)不一样！\n",
      "fontSize": 14.887386159131891,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "online一般为: loop(1->2->3->4->5->6->...) or loop(1->2->3->4->6->... and then 5)\n...表示重复左边的过程，也是loop的意思，所以可...省略,loop表示一个episode\noffline一般为:loop(1->2->3->4->6->...) and then 5 (use the data generated in the before loop) 注意和loop(1->2->3->4->6->... and then 5)不一样！\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
