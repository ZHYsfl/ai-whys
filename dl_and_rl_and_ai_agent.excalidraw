      "isDeleted": false,
      "boundElements": [],
      "updated": 1795629769184,
      "created": 1794599414448,
      "link": null,
      "locked": false,
      "text": "Training : Firstly run k_means to init, and then every time the usage frequency\nand embeddings_sum will be recorded and updated via EMA method, every time\nthe usage  frequency entropy will be recorded, every cycle(default 5) the expired\ncodes will be replaced by the data from the real input and the usage frequency\nof them will be replaced by the average usage frequency before.The codebook\nembeddings will be computed anytime via embeddings_sum/usage_frequency.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Training : Firstly run k_means to init, and then every time the usage frequency and embeddings_sum will be recorded and updated via EMA method, every time the usage  frequency entropy will be recorded, every cycle(default 5) the expired codes will be replaced by the data from the real input and the usage frequency of them will be replaced by the average usage frequency before.The codebook embeddings will be computed anytime via embeddings_sum/usage_frequency.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
